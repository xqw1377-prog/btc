# ============================================
# AURORA BTC Engine - 环境变量配置示例
# ============================================

# Binance API 配置
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ==== 运行模式（缺省=PAPER；未知值拒绝启动；PAPER 绝不连主网）====
# PAPER    默认。禁止一切交易所连接。
# SHADOW   测试网只读心跳，禁止下单。
# TESTNET  测试网。武装内核 + 收盘K决策循环；下单还需 AURORA_ENABLE_TRADING=true。
# LIVE     默认 NO-GO。需双重授权 + AURORA_ARM_LIVE=I_ARM_LIVE_EXECUTION 才允许主网 Client。
TRADING_MODE=PAPER

# 账户指纹：sha256(BINANCE_API_KEY) 前 16 位 hex。TESTNET/SHADOW/LIVE 必填。
# python3 -c "import hashlib,os;from dotenv import load_dotenv;load_dotenv();print(hashlib.sha256(os.environ['BINANCE_API_KEY'].encode()).hexdigest()[:16])"
AURORA_ACCOUNT_FINGERPRINT=

# 系统声明的持仓模式。进程只校验，不修改。切换请用：
#   python -m aurora.ops_position_mode --target HEDGE --i-understand-account-wide
AURORA_EXPECTED_POSITION_MODE=HEDGE

# LIVE 双重授权（单个变量不能开启主网）
ALLOW_LIVE_TRADING=false
AURORA_LIVE_CONFIRM=
AURORA_LIVE_KEY_SHA256=

# 遗留变量：已被 TRADING_MODE 取代。若与 TRADING_MODE 语义冲突，系统拒绝启动。
# TESTNET=true

# 数据库配置
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aurora
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=aurora

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379

# 系统配置
LOG_LEVEL=INFO

# 风控配置
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.1
MAX_LEVERAGE=5

# Telegram 报警配置 (可选)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Grafana 配置
GRAFANA_PASSWORD=your_grafana_password