# ============================================
# AURORA BTC Engine - 环境变量配置示例
# ============================================

# Binance API 配置
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
TESTNET=true

# 数据库配置
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aurora
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=aurora

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379

# 系统配置
LOG_LEVEL=INFO
TRADING_MODE=PAPER

# 风控配置
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.1
MAX_LEVERAGE=5

# Telegram 报警配置 (可选)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Grafana 配置
GRAFANA_PASSWORD=your_grafana_password